{
  "name": "side-display",
  "version": "1.0.0",
  "description": "Wireless second monitor — stream your screen to any WebRTC browser over local Wi-Fi",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild-native": "electron-rebuild -f -w @nut-tree-fork/nut-js",
    "build:addon": "electron-rebuild -f -w side-display",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "ip": "^1.1.8",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/ip": "^1.1.3",
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "node-addon-api": "^8.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
